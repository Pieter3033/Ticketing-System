INTERNAL_TICKETS_PORT=3200

# Supply private settings in .env. Empty DB settings use the surrounding SQLPage configuration.
INTERNAL_TICKETS_DB_SERVER=
INTERNAL_TICKETS_DB_PORT=1433
INTERNAL_TICKETS_DB_USER=
INTERNAL_TICKETS_DB_PASSWORD=
INTERNAL_TICKETS_DB_DATABASE=
INTERNAL_TICKETS_DB_ENCRYPT=false
INTERNAL_TICKETS_DB_TRUST_SERVER_CERT=true

# Keep uploads in a private location that is excluded from version control.
INTERNAL_TICKETS_ATTACHMENT_DIR=./private/internaltickets_attachments
INTERNAL_TICKETS_MAX_UPLOAD_BYTES=5242880

# Only needed when the API is not reverse-proxied under the page's origin.
INTERNAL_TICKETS_CORS_ORIGINS=http://localhost:8080

# Infinity uses private SQLPage configuration, which must remain outside Git.
INFINITY_JSON_PORT=3201
INFINITY_SQLPAGE_ORIGIN=http://127.0.0.1:8080
